  "operators": [
    {
      "id": "relu_fp32",
      "family": "activation",
      "op_code": 1,
      "state": "implemented",
      "input_dtypes": ["fp32"],
      "output_dtype": "fp32",
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "bit_exact_ulp0", "max_ulp": 0, "negative_zero_canonical_positive": true}
    },
    {
      "id": "gelu_fp32",
      "family": "activation",
      "op_code": 2,
      "state": "implemented",
      "input_dtypes": ["fp32"],
      "output_dtype": "fp32",
      "formula": "0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))",
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "max_abs_err", "max_abs_err": 1e-4, "reference_precision": "fp64"}
    },
    {
      "id": "cast_fp32_to_fp16",
      "family": "cast",
      "op_code": 3,
      "state": "implemented",
      "input_dtypes": ["fp32"],
      "output_dtype": "fp16",
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "bit_exact_ulp0", "max_ulp": 0, "rounding": "ieee754_rne", "subnormal_exp_min": -25}
    },
    {
      "id": "cast_fp16_to_fp32",
      "family": "cast",
      "op_code": 4,
      "state": "implemented",
      "input_dtypes": ["fp16"],
      "output_dtype": "fp32",
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "bit_exact_ulp0", "max_ulp": 0}
    },
    {
      "id": "cast_fp32_to_bf16",
      "family": "cast",
      "op_code": 5,
      "state": "implemented",
      "input_dtypes": ["fp32"],
      "output_dtype": "bf16",
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "bit_exact_ulp0", "max_ulp": 0, "rounding": "ieee754_rne"}
    },
    {
      "id": "cast_bf16_to_fp32",
      "family": "cast",
      "op_code": 6,
      "state": "implemented",
      "input_dtypes": ["bf16"],
      "output_dtype": "fp32",
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "bit_exact_ulp0", "max_ulp": 0}
    },
    {
      "id": "softmax_fp32",
      "family": "softmax",
      "op_code": 7,
      "state": "implemented",
      "input_dtypes": ["fp32"],
      "output_dtype": "fp32",
      "axis": -1,
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "max_abs_err", "max_abs_err": 1e-4, "reference_precision": "fp64"}
    },
    {
      "id": "rmsnorm_fp32",
      "family": "normalization",
      "op_code": 8,
      "state": "implemented",
      "input_dtypes": ["fp32", "fp32"],
      "output_dtype": "fp32",
      "axis": -1,
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
      "tolerance": {"type": "max_abs_err", "max_abs_err": 1e-4, "reference_precision": "fp64"}
    },
    {
      "id": "layernorm_fp32",
      "family": "normalization",
      "op_code": 9,
      "state": "implemented",
      "input_dtypes": ["fp32", "fp32", "fp32"],
      "output_dtype": "fp32",
      "axis": -1,
      "shape_constraint": "rows >= 1, cols >= 1, rows * cols <= 65536",
