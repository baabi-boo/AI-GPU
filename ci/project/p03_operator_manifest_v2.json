    },
    {
      "id": "attention_fp32",
      "family": "attention",
      "op_code": 10,
      "state": "implemented",
      "input_dtypes": ["fp32", "fp32", "fp32"],
      "output_dtype": "fp32",
      "shape_constraint": "1 <= seq_len (rows) <= 64, 1 <= d_k (cols) <= 64",
      "default_regression_shape": [8, 16],
      "tolerance": {"type": "max_abs_err", "max_abs_err": 1e-4, "reference_precision": "fp64"}
    }
  ],
  "argument_abi": {
