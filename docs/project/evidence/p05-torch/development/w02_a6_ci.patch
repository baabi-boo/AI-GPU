+      - 'python/**'
+      - 'setup.py'
+      - 'pyproject.toml'
+      - 'MANIFEST.in'
+      - 'LICENSE'
+      - 'ci/project/**'
+      - 'ci/toolchain_rev.sh'
+      - 'ci/install_dependencies.sh'
