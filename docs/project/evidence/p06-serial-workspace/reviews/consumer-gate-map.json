    "child_source": "import json,os\nfrom p05_test_runtime import FaultControls\nfrom vortex_ai import Session,Tensor,BindingError\nfmt=os.environ['P05_TEST_DTYPE'];controls=FaultControls.activate(os.environ['P05_TEST_BUNDLE'])\nsession=Session.open(os.environ['P05_TEST_BUNDLE'])\ncontrols.fail('event_release',occurrence=1)\na=Tensor(bytearray([0x12]*128),dtype=fmt,shape=(8,8),layout='row_major')\nb=Tensor(bytearray([0x34]*64),dtype=fmt,shape=(8,4),layout='column_major')\noperation=session.submit(a,b)\nassert operation.wait(1000000000).ok\nclosed=operation.close(0)\nassert closed.complete and closed.primary==0 and closed.cleanup==10\nassert operation.close(0)==closed\ntry:session.submit(a,b)\nexcept BindingError as error:\n    if error.operation is not None:assert error.operation.close(0).complete\nelse:raise AssertionError('poison bypass')\nowner=session.close();repeated=session.close()\nassert owner==repeated\ncontrols.assert_no_resources()\nprint(json.dumps({'format':fmt,'operation_close':{'complete':closed.complete,'primary':closed.primary,'cleanup':closed.cleanup,'ok':closed.ok},'session_close':{'complete':owner.complete,'primary':owner.primary,'cleanup':owner.cleanup,'ok':owner.ok},'repeat_equal':owner==repeated,'old_torch_host_assertion_would_fail':not owner.ok}),flush=True)\nassert session.close().ok, 'Reproduced outdated p05_torch_native_host_tests.py final-close assertion'\n",
