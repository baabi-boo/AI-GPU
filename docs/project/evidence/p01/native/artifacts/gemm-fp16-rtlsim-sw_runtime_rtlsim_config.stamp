--exe --language 1800-2012 --assert -Wall -Wpedantic -Wno-DECLFILENAME -Wno-REDEFMACRO --replication-limit 65536 --x-initial unique --x-assign unique verilator.vlt -DVX_CFG_XLEN=64 -DVX_CFG_XLEN_64 -DVX_CFG_NUM_CLUSTERS=1 -DVX_CFG_NUM_CORES=1 -DVX_CFG_NUM_WARPS=4 -DVX_CFG_NUM_THREADS=8 -DVX_CFG_ISSUE_WIDTH=2 -DVX_CFG_EXT_TCU_ENABLE -DVX_CFG_TCU_TYPE_TFR -DVX_CFG_FPU_TYPE_STD -DITYPE=fp16 -DOTYPE=fp32 -DVX_CFG_TCU_FP16_ENABLE -DSIMULATION -DSV_DPI -DVX_CFG_FPU_TYPE_STD -DVX_CFG_TCU_TYPE_TFR -I$BUILD/sw -I$BUILD/hw -I$SOURCE/sim/rtlsim -I$SOURCE/hw/rtl -I$SOURCE/hw/dpi -I$SOURCE/hw/rtl/libs -I$SOURCE/hw/rtl/interfaces -I$SOURCE/hw/rtl/core -I$SOURCE/hw/rtl/mem -I$SOURCE/hw/rtl/vm -I$SOURCE/hw/rtl/cache -I$SOURCE/hw/rtl/fpu -I$SOURCE/hw/rtl/tcu -I$SOURCE/hw/rtl/tcu/tfr $SOURCE/hw/rtl/VX_gpu_pkg.sv $SOURCE/hw/rtl/fpu/VX_fpu_pkg.sv $SOURCE/hw/rtl/tcu/VX_tcu_pkg.sv $SOURCE/hw/rtl/VX_trace_pkg.sv  --cc rtlsim_shim --top-module rtlsim_shim -j 2 -DNDEBUG -MAKEFLAGS OPT_FAST=-O2 -MAKEFLAGS OPT_GLOBAL=-O2
-std=c++17 -Wall -Wextra -Wfatal-errors -Werror -fPIC -fno-tree-loop-distribute-patterns -I$BUILD/sw -I$BUILD/hw -I$SOURCE/sim/common -I$SOURCE/sw/common -I$SOURCE/third_party/softfloat/source/include -I$SOURCE/third_party/ramulator/ext/spdlog/include -I$SOURCE/third_party/ramulator/ext/yaml-cpp/include -I$SOURCE/third_party/ramulator/src -DVX_CFG_XLEN=64 -DVX_CFG_XLEN_64 -DVX_CFG_NUM_CLUSTERS=1 -DVX_CFG_NUM_CORES=1 -DVX_CFG_NUM_WARPS=4 -DVX_CFG_NUM_THREADS=8 -DVX_CFG_ISSUE_WIDTH=2 -DVX_CFG_EXT_TCU_ENABLE -DVX_CFG_TCU_TYPE_TFR -DVX_CFG_FPU_TYPE_STD -DITYPE=fp16 -DOTYPE=fp32 -DVX_CFG_TCU_FP16_ENABLE -DSIMULATION -DSV_DPI -DNDEBUG
